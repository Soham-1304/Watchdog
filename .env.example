# Gemini API Key (server side only; backend agents use deterministic fallbacks when unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin used by the browser when the API is deployed separately.
# Leave empty for local Vite proxying; set to the deployed API origin in Vercel.
VITE_CUTAWAY_API_URL=

# Comma-separated frontend origins allowed by the separately hosted FastAPI API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
